* {
  box-sizing: border-box;
}

body {
  font-family: system-ui, sans-serif;
  background-color: #59e4f3;
  display: grid;
  min-height: 100vh;
  margin: 0;
  place-items: center;
  padding: 5cqi;
}

h1 {
  text-align: center;
  margin-top: 30px;
  font-size: 3rem;
  font-weight: bold;
  color: #d9c91d;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
  letter-spacing: 1px;
  text-transform: uppercase;
  width: 100%;
  max-width: 650px;
  padding: 12px 20px;
  background-color: #0d98f4;
  border-radius: 8px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.15);
}

.button-class {
  display: block;
  margin: 20px auto;
  padding: 14px 36px;
  font-size: 1.6rem;
  font-weight: bold;
  color: #fff;
  background-color: #0d98f4;
  border: none;
  border-radius: 8px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
  cursor: pointer;
  transition: all 0.3s ease;
  position: absolute;
  top: 52%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 10;
}

.button-class:hover {
  background-color: #0b7dd8;
  transform: translate(-50%, calc(-50% - 3px));
  box-shadow: 0 6px 12px rgba(0, 0, 0, 0.25);
}
